# ── Adapters to enable (comma-separated: telegram, slack, discord) ──
ENABLED_ADAPTERS=telegram

# ── Claude CLI settings ──
# Working directory for Claude CLI commands
CLAUDE_WORKING_DIR=/path/to/your/project
# Maximum execution time in seconds (default: 300)
CLAUDE_TIMEOUT=300
# Directories the runner is allowed to operate in (comma-separated, defaults to CLAUDE_WORKING_DIR)
ALLOWED_DIRECTORIES=/path/to/your/project

# ── Telegram ──
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
# Comma-separated Telegram user IDs allowed to use the bot (empty = allow all)
ALLOWED_TELEGRAM_USERS=

# ── Slack ──
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token
SLACK_SIGNING_SECRET=your-slack-signing-secret
# Comma-separated Slack user IDs allowed to use the bot (empty = allow all)
ALLOWED_SLACK_USERS=

# ── Discord ──
DISCORD_BOT_TOKEN=your-discord-bot-token
# Comma-separated Discord user IDs allowed to use the bot (empty = allow all)
ALLOWED_DISCORD_USERS=
